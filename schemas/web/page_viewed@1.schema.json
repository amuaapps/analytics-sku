{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "web/page_viewed@1",
  "title": "Page Viewed Event",
  "description": "Fired when a user views a page",
  "type": "object",
  "properties": {
    "page_path": {
      "type": "string",
      "description": "Page path (e.g., /home, /products/123)"
    },
    "page_title": {
      "type": "string",
      "description": "Page title"
    },
    "page_category": {
      "type": "string",
      "description": "Page category (e.g., landing, product, checkout)"
    },
    "navigation": {
      "type": "object",
      "description": "Navigation context",
      "properties": {
        "from_path": {
          "type": "string",
          "description": "Previous page path"
        },
        "referrer_host": {
          "type": "string",
          "description": "Referrer hostname"
        }
      }
    }
  },
  "additionalProperties": true
}
