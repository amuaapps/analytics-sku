{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "checkout/payment_submitted@1",
  "title": "Payment Submitted Event",
  "description": "Fired when a user submits payment information",
  "type": "object",
  "required": ["orderId", "amount", "currency", "paymentMethod"],
  "properties": {
    "orderId": {
      "type": "string",
      "description": "Unique order identifier",
      "minLength": 1
    },
    "amount": {
      "type": "number",
      "description": "Payment amount",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 currency code",
      "pattern": "^[A-Z]{3}$"
    },
    "paymentMethod": {
      "type": "string",
      "description": "Payment method used",
      "enum": ["credit_card", "debit_card", "paypal", "apple_pay", "google_pay"]
    },
    "items": {
      "type": "array",
      "description": "Items in the order",
      "items": {
        "type": "object",
        "required": ["productId", "quantity", "price"],
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": false
}
